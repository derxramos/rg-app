# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# Variables that start with NEXT_PUBLIC_ are sent to the browser. Do not put secrets in them.

# ---------- Database (Supabase) ----------
# Pooled "transaction" URL, port 6543. Used by the app. SECRET.
DATABASE_URL=
# Direct URL, port 5432. Used only for migrations, the seed and tests. SECRET.
DIRECT_DATABASE_URL=

# ---------- Supabase API ----------
# Project URL, for example https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public (publishable) key. Safe for the browser. Row Level Security blocks every table for this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key. Server and scripts only (storage, admin invites). SECRET.
SUPABASE_SECRET_KEY=
# Storage bucket names (created by `pnpm storage:setup`).
SUPABASE_BUCKET_CLIENT_FILES=client-files
SUPABASE_BUCKET_PUBLIC_ASSETS=public-assets

# ---------- Cloudflare Turnstile (spam protection) ----------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# SECRET.
TURNSTILE_SECRET_KEY=

# ---------- Email (Brevo) ----------
# SECRET.
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Where "new request" and "contact form" emails go.
ADMIN_NOTIFY_EMAIL=

# ---------- App ----------
# Website address used in links inside emails. Local: http://localhost:3000
APP_BASE_URL=http://localhost:3000
# Long random text used to sign cookies, tokens and IP hashes. SECRET.
# Make one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_HASH_SECRET=

# ---------- Admin 2FA ----------
# SERVER ONLY. Never rename it to NEXT_PUBLIC_.
# ONLY the exact word false turns admin 2-step login OFF. Missing, empty, true, 0, no, off or anything
# else means 2FA is REQUIRED (the safe default). While it is false, a red banner shows on every admin page
# and the server log gets a warning at start. Role checks and database rules still apply.
# Before real clients use the site, set it to true (or remove it). See docs/SETUP_GUIDE.md.
ADMIN_REQUIRE_2FA=

# ---------- First owner account (used only by `pnpm db:seed`) ----------
# The seed creates ONE account with the highest role (owner). Use the real owner's email for production.
# For local tests keep a clearly fake address like the one below.
SEED_OWNER_EMAIL=zolb-test+owner@example.com
SEED_OWNER_NAME=Test Owner
# At least 12 characters. Remove this line from .env.local after the seed has run.
SEED_OWNER_PASSWORD=

# ---------- Local development only ----------
# Lets you open /admin on your own computer WITHOUT Supabase. It works only when NODE_ENV is development
# (never in a build or in production). The email must have an active row in admin_profiles.
# The fresh 2FA code in this mode is 000000. Leave this empty on every real server.
DEV_ADMIN_BYPASS_EMAIL=
# Use 1 with the local test database (pnpm dev:db). It allows one query at a time.
DB_POOL_MAX=
